# apps/web 전용 환경변수 (루트 .env.example 의 웹 관련 값과 동기화)
# 실제 값은 .env.local 에 두고 커밋 금지
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# VECTA 블로그 주소 — 홈의 주간 브리핑·매크로·기업 분석 섹션이 여기 /posts.json 을 읽는다.
# 비워 두면 요청하지 않고 그 세 섹션은 렌더되지 않는다(블로그 배포 전 정상 상태).
# 로컬에서 블로그 dev 서버를 띄웠다면 http://localhost:3100, 배포 후에는 블로그 도메인.
BLOG_URL=

# 사이트 대표 주소(2026-09-14, https://vecta.win). OG·canonical 의 절대 주소가 여기서 나오고,
# 프로덕션에서는 옛 *.vercel.app 주소를 이리로 308 리다이렉트한다. 로컬은 비워 둔다.
# 관리 화면은 별도 env 없이 «admin.» 으로 시작하는 호스트로 갈린다 — 로컬은 http://admin.localhost:3000
NEXT_PUBLIC_SITE_URL=
