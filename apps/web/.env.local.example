# apps/web 전용 환경변수 (루트 .env.example 의 웹 관련 값과 동기화)
# 실제 값은 .env.local 에 두고 커밋 금지
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# VECTA 블로그 주소 — 홈의 주간 브리핑·매크로·기업 분석 섹션이 여기 /posts.json 을 읽는다.
# 비워 두면 요청하지 않고 그 세 섹션은 렌더되지 않는다(블로그 배포 전 정상 상태).
# 로컬에서 블로그 dev 서버를 띄웠다면 그 주소, 배포 후에는 블로그 도메인.
BLOG_URL=
