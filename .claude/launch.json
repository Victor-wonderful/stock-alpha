{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev:preview"
      ],
      "port": 4010
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev:verify"
      ],
      "autoPort": true,
      "env": {
        "NEXT_DIST_DIR": ".next-verify"
      },
      "port": 3000
    },
    {
      "name": "blog",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/vecta-blog",
        "run",
        "dev"
      ],
      "port": 3100,
      "autoPort": false
    }
  ]
}
