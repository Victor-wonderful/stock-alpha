                  "children": [
                    {
                      "type": "text",
                      "id": "ispfn",
                      "name": "투자 유의 · 이 서비스는 유사투자자문업자가 불특정 다수를 대상으로 제공",
                      "context": "p",
                      "fill": "#61677a",
                      "textGrowth": "fixed-width-height",
                      "width": "fill_container",
                      "height": 37.38,
                      "content": "투자 유의 · 이 서비스는 유사투자자문업자가 불특정 다수를 대상으로 제공하는 투자 참고 정보입니다. 개별 회원의 사정을 반영한 맞춤 자문이 아니며, 매매를 대신하거나 자금을 맡아 운용하지 않습니다. 모든 수치는 과거 데이터로 계산한 것이고 과거 성과는 미래 수익을 보장하지 않습니다. 투자 판단과 그 결과에 대한 책임은 투자자 본인에게 있습니다.",
                      "lineHeight": 1.63,
                      "fontFamily": "Pretendard Variable",
                      "fontSize": 11.5,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "g0gFd5",
                      "name": "spacer",
                      "width": "fill_container",
